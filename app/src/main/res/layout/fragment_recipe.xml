<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btn_start_recipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- שם מתכון -->
    <TextView
        android:id="@+id/tv_recipe_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Chocolate Cake"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_recipe_photo"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:contentDescription="@string/recipe"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:srcCompat="@tools:sample/backgrounds/scenic"
        tools:visibility="visible" />

    <!-- תיאור קצר -->
    <TextView
        android:id="@+id/tv_recipe_short_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Rich and moist chocolate cake with dark chocolate ganache."
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_recipe_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="by @username"
        android:textColor="#888888"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_ingredients_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ingredient"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ingredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:itemCount="2"
        tools:listitem="@layout/item_kitchen_item" />

    <TextView
        android:id="@+id/tv_preparation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rotationX="0"
        android:text="@string/instructions"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_preparation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Preheat the oven to 180°C.  Mix the eggs and sugar in a bowl.  Add the butter, flour, and chocolate.  Pour into a baking pan and bake for 30 minutes." />

    <Button
        android:id="@+id/btn_make"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/action_make_recipe" />

    <!-- Owner Actions (Edit & Delete) -->
    <LinearLayout
        android:id="@+id/layout_owner_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

    <Button
            android:id="@+id/btn_update_recipe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/edit_recipe"
            android:backgroundTint="#BB86FC"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_delete_recipe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/delete"
            android:backgroundTint="#CF6679"
            android:textColor="@android:color/white" />

    </LinearLayout>


</LinearLayout>
